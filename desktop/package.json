{
  "name": "medconnecte-caisse",
  "productName": "MedConnecte Caisse",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "preparer": "node node_modules/electron/install.js",
    "construire:front": "node scripts/construire-front.mjs",
    "construire": "node scripts/construire-electron.mjs",
    "demarrer": "node scripts/construire-electron.mjs --sans-bytecode && electron .",
    "empaqueter": "node scripts/empaqueter.mjs",
    "controler": "node scripts/controler-sortie.mjs",
    "dist": "npm run construire:front && npm run construire && npm run empaqueter && npm run controler",
    "test": "vitest run",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "2.1.3",
    "@types/node": "24.0.0",
    "bytenode": "1.5.7",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
