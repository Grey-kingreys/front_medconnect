#!/bin/sh
# Pre-push gate generated by bootstrap-orchestrateur v2.
# Full test suite, once per push instead of once per task commit.
set -e

# Tests Vitest d'abord, puis build de production.
# Toujours en local : dans le conteneur de dev, 'next build' ecraserait le .next
# utilise par 'next dev' (volume frontend_next) et casserait le serveur de dev.
GATE_SERVICE=frontend
. "$(dirname "$0")/gate-lib.sh"
echo "Verification: tests Vitest puis build de production (local)." >&2
run_local npm test
run_local npm run build
